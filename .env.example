PORT=3000

# Orígenes web con CORS, separados por coma (vacío = sin CORS; la app nativa no lo usa).
# Para probar la app en el navegador (Expo web) en local: CORS_ORIGINS=http://localhost:8081
# Para probar la versión web de native en local: http://localhost:8081
CORS_ORIGINS=
# Proxies delante del server (su balanceador, en Render; verificar cuántos). Sin esto, el
# rate limit por IP ve la IP del proxy.
TRUST_PROXY_HOPS=0

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional — Upstash Redis two-level cache (omit to disable Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Solo para el ETL (enriquecimiento con IA): el server no la necesita.
ANTHROPIC_API_KEY=
