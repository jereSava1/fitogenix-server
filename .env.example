PORT=3000
# Nivel de los logs (pino): info por defecto.
LOG_LEVEL=info

# Orígenes web con CORS, separados por coma (vacío = sin CORS; la app nativa no lo usa).
# Para probar la versión web de native en local: CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=
# Direcciones de los proxies delante del server, separadas por coma (en Render: 10.0.0.0/8).
# Vacío en local. Sin esto, el rate limit y Supabase ven la IP del proxy y no la del usuario.
TRUST_PROXY=

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional — Upstash Redis two-level cache (omit to disable Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Solo para el ETL (enriquecimiento con IA): el server no la necesita.
ANTHROPIC_API_KEY=
