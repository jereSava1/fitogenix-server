      "patch": {
        "summary": "Editar los datos personales (solo los campos que se mandan)",
        "tags": [
          "account"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "minProperties": 1,
                "type": "object",
                "properties": {
                  "firstName": {
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "lastName": {
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "username": {
                    "minLength": 3,
                    "maxLength": 30,
                    "pattern": "^[a-z0-9_.]+$",
                    "type": "string"
                  },
                  "phone": {
                    "pattern": "^\\+[1-9][0-9]{6,14}$",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
