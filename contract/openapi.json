{
  "openapi": "3.1.0",
  "info": {
    "title": "Fitogenix API",
    "version": "0.7.0",
    "description": "Contrato HTTP del server de Fitogenix, generado desde los schemas de las rutas (docs/adr/0011). Historial de cambios: contract/CHANGELOG.md."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token de Supabase Auth"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHENTICATED",
              "NOT_FOUND",
              "PRODUCT_NOT_IN_CATALOG",
              "RATE_LIMITED",
              "DEPENDENCY_UNAVAILABLE",
              "USERNAME_TAKEN",
              "INTERNAL"
            ]
          }
        }
      },
      "ProductSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "imageUrl",
          "score",
          "scoreLabel",
          "scoreColor"
        ],
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "scoreLabel": {
            "type": "string",
            "enum": [
              "EXCELENTE",
              "BUENO",
              "MODERADO",
              "MALO",
              "SIN DATOS SUFICIENTES"
            ]
          },
          "scoreColor": {
            "type": "string"
          }
        }
      },
      "ProductDetail": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "imageUrl",
          "score",
          "scoreLabel",
          "scoreColor",
          "noScore",
          "fito",
          "highlight",
          "ingredients",
          "nutrition"
        ],
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": [
              "null",
              "number"
            ]
          },
          "scoreLabel": {
            "type": "string",
            "enum": [
              "EXCELENTE",
              "BUENO",
              "MODERADO",
              "MALO",
              "SIN DATOS SUFICIENTES"
            ]
          },
          "scoreColor": {
            "type": "string"
          },
          "noScore": {
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "fuera-de-alcance",
                  "no-alimentario",
                  "sin-ingredientes",
                  "solo-categorias",
                  "sin-identificar",
                  "solo-certificaciones"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "type": [
              "null",
              "object"
            ]
          },
          "fito": {
            "type": "string",
            "enum": [
              "fito",
              "nofito",
              "none"
            ]
          },
          "highlight": {
            "type": "string",
            "enum": [
              "cuestionables",
              "beneficiosos",
              "ninguno"
            ]
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "sev",
                "desc"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sev": {
                  "type": "string",
                  "enum": [
                    "red",
                    "orange",
                    "yellow",
                    "green",
                    "gray"
                  ]
                },
                "desc": {
                  "type": "string"
                }
              }
            }
          },
          "nutrition": {
            "type": "object",
            "required": [
              "calories",
              "protein",
              "carbs",
              "sugars",
              "fats",
              "satFats",
              "sodium",
              "fiber",
              "transFat",
              "cholesterol"
            ],
            "properties": {
              "calories": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "protein": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "carbs": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "sugars": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "fats": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "satFats": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "sodium": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "fiber": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "transFat": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "cholesterol": {
                "type": [
                  "null",
                  "number"
                ]
              }
            }
          }
        }
      },
      "Ok": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "username",
          "phone"
        ],
        "properties": {
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastName": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SavedItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "imageUrl",
          "score",
          "scoreLabel",
          "scoreColor",
          "savedAt"
        ],
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": [
              "null",
              "number"
            ]
          },
          "scoreLabel": {
            "type": "string",
            "enum": [
              "EXCELENTE",
              "BUENO",
              "MODERADO",
              "MALO",
              "SIN DATOS SUFICIENTES"
            ]
          },
          "scoreColor": {
            "type": "string"
          },
          "savedAt": {
            "format": "date-time",
            "type": "string"
          }
        }
      },
      "HistoryItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "imageUrl",
          "score",
          "scoreLabel",
          "scoreColor",
          "scannedAt"
        ],
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": [
              "null",
              "number"
            ]
          },
          "scoreLabel": {
            "type": "string",
            "enum": [
              "EXCELENTE",
              "BUENO",
              "MODERADO",
              "MALO",
              "SIN DATOS SUFICIENTES"
            ]
          },
          "scoreColor": {
            "type": "string"
          },
          "scannedAt": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    }
